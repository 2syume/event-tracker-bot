# Required API keys
# Telegram bot token from BotFather
TELEGRAM_BOT_TOKEN=

# OpenRouter API key for LLM access (Gemini 2.5 Flash, DeepSeek V3.1)
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: Route preferences
OPENROUTER_GEMINI_MODEL=google/gemini-2.5-flash
OPENROUTER_DEEPSEEK_MODEL=deepseek/deepseek-chat-v3.1

# Google Service Account JSON (base64-encoded) or path
GOOGLE_SERVICE_ACCOUNT_B64=
# Spreadsheet ID and Sheet name to store events
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Events

# Optional: Proxy or timeout configs
HTTP_TIMEOUT_MS=20000
